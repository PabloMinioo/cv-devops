discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "cv-devops(-monitoring)?"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

discovery.relabel "api" {
  targets = discovery.relabel.containers.output
  rule {
    source_labels = ["service"]
    regex         = "api"
    action        = "keep"
  }
}

discovery.relabel "others" {
  targets = discovery.relabel.containers.output
  rule {
    source_labels = ["service"]
    regex         = "api"
    action        = "drop"
  }
}

loki.source.docker "api" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.api.output
  forward_to = [loki.process.api.receiver]
}

loki.source.docker "others" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.others.output
  forward_to = [loki.process.others.receiver]
}

loki.process "api" {
  forward_to = [loki.write.local.receiver]

  // Une el stack trace (varias líneas) con el log que lo originó:
  // una excepción queda como UN solo evento, no como 30 líneas sueltas.
  stage.multiline {
    firstline     = `^\d{4}-\d{2}-\d{2}T`
    max_wait_time = "3s"
  }

  // Nivel (INFO / WARN / ERROR) tomado del formato de Spring Boot
  stage.regex {
    expression = `^\S+\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\s`
  }
  stage.template {
    source   = "level"
    template = `{{ ToLower .Value }}`
  }
  stage.labels {
    values = { level = "" }
  }
}

loki.process "others" {
  forward_to = [loki.write.local.receiver]

  // Ruido: los healthchecks de nginx se ejecutan cada 15 s y no aportan
  stage.drop {
    expression          = `"(GET|HEAD) /(health|actuator/health)[ ?]`
    drop_counter_reason = "healthcheck"
  }

  stage.match {
    selector = `{service=~"prometheus|alertmanager|grafana|loki|alloy|node-exporter|postgres-exporter"}`

    stage.logfmt {
      mapping = { level = "" }
    }
    stage.template {
      source   = "level"
      template = `{{ ToLower .Value }}`
    }
    stage.labels {
      values = { level = "" }
    }
  }

  stage.match {
    selector = `{service="postgres"}`

    stage.regex {
      expression = `\[\d+\] (?P<level>LOG|WARNING|ERROR|FATAL|PANIC)`
    }
    stage.template {
      source   = "level"
      template = `{{ if eq .Value "LOG" }}info{{ else if eq .Value "WARNING" }}warn{{ else }}error{{ end }}`
    }
    stage.labels {
      values = { level = "" }
    }
  }

  stage.match {
    selector = `{service="cadvisor"}`

    stage.regex {
      expression = `^(?P<level>[IWEF])\d{4} `
    }
    stage.template {
      source   = "level"
      template = `{{ if eq .Value "W" }}warn{{ else if eq .Value "E" }}error{{ else if eq .Value "F" }}error{{ else }}info{{ end }}`
    }
    stage.labels {
      values = { level = "" }
    }
  }

  stage.match {
    selector = `{service="nginx"}`

    stage.regex {
      expression = `" (?P<level>[0-9])[0-9]{2} `
    }
    stage.template {
      source   = "level"
      template = `{{ if eq .Value "5" }}error{{ else if eq .Value "4" }}warn{{ else }}info{{ end }}`
    }
    stage.labels {
      values = { level = "" }
    }
  }

  stage.match {
    selector = `{service="nginx"} |~ "\\[(error|crit|alert|emerg)\\]"`

    stage.static_labels {
      values = { level = "error" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
